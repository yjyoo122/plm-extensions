{
    "manifest_version": 3,
    "name": "PLM UX Extensions",
    "version": "1.1",
    "description": "Adds PLM UX Extensions commands to the Fusion Manage standard user interface, and starts / stops the local UX server",
    // Fixes the extension ID (hoihaoempgngpcglmnamdadlbplnkopl) wherever the folder is loaded from. The start / stop
    // helper in chrome-host/ only answers this ID. Public key only - there is no private key to keep secret.
    "key": "",
    "icons" : {
         "16" : "icon-16.png",
         "48" : "icon-48.png",
        "128" : "icon-128.png"
    },
    "permissions": [
        "activeTab",
        "storage",
        "background",
        "nativeMessaging"
    ],
    "action": {
        "default_popup" : "options.html",
        "default_icon"  : {
             "16" : "icon-16.png",
             "48" : "icon-48.png",
            "128" : "icon-128.png"
        }
    },
    "background": {
        "service_worker": "background.js"
    },
    "host_permissions": [   
        // Adjust this list to match all the possible UX servers you may want to connect to
        "http://localhost:8080/*",
        "https://plm-extensions-adsk2504demo-439208211811.europe-west1.run.app/*"
    ],
    "content_scripts": [{
        "matches": [
            "*://*.autodeskplm360.net/*"
        ],
        "js": [
            "content.js"
        ],
        "run_at": "document_start"
    }]
}